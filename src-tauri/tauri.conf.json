{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yt-dlp-ui",
  "version": "0.1.2",
  "identifier": "io.github.anosatsuk124.ytdlp-ui",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "yt-dlp-ui",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/anosatsuk124/yt-dlp-ui/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2MTA3QUYyQjY5OEJCOTgKUldTWXU1aTI4bm9RSnN4TENkbDhRRlo2U1lEVmZSUU9SUlNVMEFSZVd4a1dRY3VJWStkQWlnNlcK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Drive yt-dlp from a native desktop app",
    "externalBin": [
      "binaries/downloader",
      "binaries/node"
    ],
    "resources": {
      "resources/web": "web",
      "resources/bin": "bin"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
