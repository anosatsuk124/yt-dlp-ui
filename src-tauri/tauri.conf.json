{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yt-dlp-ui",
  "version": "0.1.0",
  "identifier": "io.github.anosatsuk124.ytdlp-ui",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "yt-dlp-ui",
        "width": 1100,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Drive yt-dlp from a native desktop app",
    "externalBin": [
      "binaries/downloader",
      "binaries/node"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
