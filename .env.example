# Only user-tunable settings live here. Container-internal paths
# (yt-dlp binary location, /downloads, /cookies, /data, the downloader's
# in-network URL) are baked into the images and compose file — those are
# not user concerns.

# Maximum number of yt-dlp jobs that may run concurrently.
DOWNLOADER_MAX_PARALLEL=2

# Host-side directories that get bind-mounted into the containers.
HOST_DOWNLOAD_DIR=./downloads
HOST_COOKIES_DIR=./cookies
HOST_DATA_DIR=./data

# Host port the web UI is published on (ignored when using the
# tailscale override — there the UI is only reachable via the tailnet).
WEB_PORT=3000

# --- Tailscale sidecar (only used with docker-compose.tailscale.yml) ---
# Generate a reusable, ephemeral pre-auth key at
# https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=yt-dlp-ui
# Optional: route the stack's egress (yt-dlp downloads + the web container's
# traffic) through a Tailscale exit node. Set to the exit node's IP or MagicDNS
# name (must already be advertised and approved in your tailnet). Leave empty to
# use default routing.
TS_EXIT_NODE=

# Optional: share an existing external macvlan network with another same-host
# tailnet node (e.g. a self-hosted exit node) for a DIRECT connection instead of
# a slow DERP relay. Only used when you add `-f docker-compose.macvlan.yml`.
# TS_MACVLAN_NETWORK = name of the existing external macvlan network
# TS_MACVLAN_IP      = a free static IP for this container on that subnet
TS_MACVLAN_NETWORK=
TS_MACVLAN_IP=
